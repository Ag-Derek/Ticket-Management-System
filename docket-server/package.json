{
  "name": "docket-server",
  "version": "0.1.0",
  "description": "API for the Docket support ticket portal, backed by Supabase (Postgres + Storage)",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "seed": "node db/seed.js",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test --require ./test/setup.js \"test/**/*.test.js\"",
    "backup": "node scripts/backup.js",
    "migrate-to-postgres": "node db/migrate-to-postgres.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "docx": "^9.16.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.5",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "better-sqlite3": "^13.2.0"
  }
}
