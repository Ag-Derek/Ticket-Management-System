{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en-US",
  "useGitignore": true,
  "files": ["**/*.{js,html,md,css}"],
  "ignorePaths": [
    "cspell.json",
    "**/node_modules/**",
    "**/package-lock.json",
    "**/.env*",
    "**/*.backup*",
    "**/backups/**",
    "docket-server/db/migrate-to-postgres.js",
    "docket-server/db/remove-seeded-agents.js"
  ],
  "ignoreRegExpList": [
    "HelpbotKeywords",
    "PowerShellSwitches"
  ],
  "patterns": [
    {
      "name": "HelpbotKeywords",
      "description": "Helpbot keyword lists deliberately include alternate spellings (licence, normalise) so user questions still match.",
      "pattern": "/words:\\s*\\[[^\\]]*\\]/g"
    },
    {
      "name": "PowerShellSwitches",
      "description": "PowerShell cmdlet switches such as -DontStopIfGoingOnBatteries.",
      "pattern": "/-Dont[A-Za-z]+/g"
    }
  ],
  "words": [
    "Docket",
    "DOCKETBK",
    "Remat",
    "Supabase",
    "Resend",
    "MFA",
    "HMAC",
    "Healthchecks",
    "onrender",
    "pooler",
    "helpbot",
    "topbar",
    "Riskflow",
    "Orcaa",
    "Hubtel",
    "Arkesel",
    "mnotify",
    "Telecel",
    "airteltigo",
    "loginable",
    "refetches",
    "resends",
    "sitewide",
    "unassigning",
    "Agorhom",
    "Asante",
    "Boateng",
    "Efia",
    "Kwame",
    "Mensah",
    "Nana",
    "Owusu",
    "Serwaa",
    "hashtext",
    "ILIKE",
    "MINVALUE",
    "nextval",
    "regclass",
    "setval",
    "timestamptz",
    "xact",
    "ampm",
    "cellspacing",
    "geolocation",
    "inputmode",
    "labelledby",
    "maxlength",
    "nosniff",
    "nums",
    "officedocument",
    "openxmlformats",
    "Segoe",
    "USERPROFILE",
    "vcard",
    "wordprocessingml",
    "noextension"
  ]
}
